---
import { Image } from "astro:assets";

const { title, img, desc, url, badge, target = "_blank" } = Astro.props;

import {
  CARD_OP,
  GET_COLORS_METADATA,
  BORDER_OPACITY,
  SPACES_BETWEEN_CARDS,
} from "@styles/utilsCSS";
---

<a
  href={url}
  target={target}
  rel="noopener"
  class={`group flex ${BORDER_OPACITY} ${SPACES_BETWEEN_CARDS.PADDING} mx-auto flex-col`}
>
  <!-- BADGE -->
  <div class="flex items-center gap-2 mt-1 mb-1.5">
    <span class={GET_COLORS_METADATA("cardsImg")}>{badge}</span>
  </div>

  <!-- TITLE -->
  <h2
    class={`${CARD_OP.title} group-hover:text-primary line-clamp-3 md:line-clamp-none transition-colors`}
  >
    {title}
  </h2>

  <!-- IMAGE -->
  {img && (
    <div class="flex justify-center overflow-hidden my-5">
      <Image
        src={img}
        format="webp"
        alt={title}
        class="max-w-full md:max-w-60 rounded-md"
      />
    </div>
  )}

  <!-- DESCRIPTION -->
  <p class={`${CARD_OP.parr} md:line-clamp-none`}>{desc}</p>
</a>
