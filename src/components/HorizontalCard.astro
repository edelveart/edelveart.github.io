---
import { Image } from "astro:assets";

const { title, img, desc, url, badge, target = "_blank" } = Astro.props;

import {
  CARD_OP,
  GET_COLORS_METADATA,
  BORDER_OPACITY,
  SPACES_BETWEEN_CARDS,
} from "@styles/utilsCSS";
---

<a
  href={url}
  target={target}
  rel={target === "_blank" ? "noopener noreferrer" : undefined}
  class={`group flex h-full flex-col ${BORDER_OPACITY} ${SPACES_BETWEEN_CARDS.PADDING} mx-auto`}
>
  <!-- BADGE -->
  <div class="flex items-center gap-2 mb-2">
    <span class={GET_COLORS_METADATA("cardsImg")}>{badge}</span>
  </div>

  <!-- TITLE -->
  <h2 class={`${CARD_OP.title}  group-hover:text-primary transition-colors`}>
    {title}
  </h2>

  <!-- IMAGE -->
  <div class="my-4 overflow-hidden rounded-md">
    <Image src={img} format="webp" alt={title} class="w-full h-auto" />
  </div>

  <!-- DESCRIPTION -->
  <p class={`${CARD_OP.parr}`}>{desc}</p>
</a>
