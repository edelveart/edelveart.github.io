---
import GitHub from "@icons/GitHub.astro";
// import Instagram from "@icons/Instagram.astro"
import LinkedIn from "@icons/LinkedIn.astro";
import QR from "@icons/QR.astro";
import Youtube from "@icons/Youtube.astro";
import { SOCIAL_MEDIA } from "@ts-config-path/config";

const cssIconsClass = `
  size-10
  flex items-center justify-center
  rounded-md
  text-base-content/70
  transition-all duration-200 ease-in-out
  hover:text-primary
`;
const size = "size-4 shrink-0";
---

<a
  href={SOCIAL_MEDIA.linkedin}
  target="_blank"
  title="LinkedIn"
  class={cssIconsClass}
  aria-label="LinkedIn"
>
  <LinkedIn class={size} />
</a>

<a
  href={SOCIAL_MEDIA.github}
  target="_blank"
  title="GitHub"
  class={cssIconsClass}
  aria-label="GitHub"
>
  <GitHub class={size} />
</a>

<a
  href={SOCIAL_MEDIA.youtube}
  title="Youtube"
  target="_blank"
  class={cssIconsClass}
  aria-label="Youtube"
>
  <Youtube class={size} />
</a>
