    💻 MuseScore 2`,
    },
  ],
};

interface Props {
  lang?: "en" | "es";
  indices?: number[];
}

const { lang = "en", indices } = Astro.props;

const workExperiences = allExperiences[lang];

const filteredExperiences = indices
  ? indices.map((index) => workExperiences[index]).filter(Boolean)
  : workExperiences;
---

<div class="text-3xl w-full font-bold flex items-center my-10">
  {lang === "es" ? "Experiencia" : "Experience"}
</div>

<div class="time-line-container mb-8 grid gap-3">
  {
    filteredExperiences.map((experience: Experience, index: number) => (
      <>
        <TimeLineElement
          key={index}
          title={experience.title}
          subtitle={experience.subtitle}
          description={experience.description}
        />
      </>
    ))
  }
</div>
