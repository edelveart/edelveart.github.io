<a
  class={`${NAV_LINKS_PAGES.aLink} ${NAV_LINKS_PAGES.nextRight}`}
  href="/blog/"
>
  <div>
    <div
      class={`${NAV_LINKS_PAGES.pageTitle} text-sm text-neutral-content whitespace-nowrap`}
    >
      {isSpanish ? "Explorar archivo" : "Explore archive"}
    </div>
  </div>

  <span class={NAV_LINKS_PAGES.arrowSpan}>
    <Arrows direction="right" size="sm" />
  </span>
</a>
