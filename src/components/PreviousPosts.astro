---
import Arrows from "@icons/Arrows.astro";
import { NAV_LINKS_PAGES } from "@styles/utilsCSS";

interface Props {
  lang?: "es" | "en";
}

const { lang = "en" } = Astro.props;
const isSpanish = lang === "es";
---

<div class="grid grid-cols-2 gap-4">
  <!-- EMPTY DIV => DON'T REMOVE -->
  <div></div>

  <a
    class={`${NAV_LINKS_PAGES.aLink} ${NAV_LINKS_PAGES.nextRight}`}
    href="/blog/"
  >
    <div class="text-right">
      <div class={NAV_LINKS_PAGES.prevNext}>
        {isSpanish ? "ARCHIVO" : "ARCHIVE"}
      </div>

      <div class={`${NAV_LINKS_PAGES.pageTitle} whitespace-nowrap`}>
        {isSpanish ? "Explorar todas las notas" : "Explore all notes"}
      </div>
    </div>

    <span class={NAV_LINKS_PAGES.arrowSpan}>
      <Arrows direction="right" />
    </span>
  </a>
</div>
