---
interface Props {
  title: string;
}
import { BULLET_SQUARE_LIST } from "@ts-config-path/pages/about.astro";
import { LINKS_TO } from "@styles/utilsCSS";
const { title } = Astro.props;
---

<section class="mb-10">
  <h2 class="text-2xl font-semibold my-5">{title}</h2>
  <ul class="flex flex-col gap-y-2">
    <li class={BULLET_SQUARE_LIST.li}>
      <span class={BULLET_SQUARE_LIST.span}></span>
      <a
        class={LINKS_TO}
        href="/resources-files/errata-phd-thesis-cannas.pdf"
        target="_blank"
        rel="noopener"
      >
        Errata de la tesis doctoral (PhD) <em>
          Geometric Representation and Algebraic Formalization of Musical
          Structures
        </em> (2018)
      </a>
    </li>
    <li class={BULLET_SQUARE_LIST.li}>
      <span class={BULLET_SQUARE_LIST.span}></span>
      <a
        class={LINKS_TO}
        href="/resources-files/errata-figuratenum.pdf"
        target="_blank"
        rel="noopener"
      >
        Errata of <em>Figurate Numbers</em> (2012)
      </a>
    </li>
  </ul>
</section>
