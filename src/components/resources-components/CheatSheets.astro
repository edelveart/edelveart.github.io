---
interface Props {
  title: string;
}
import { BULLET_SQUARE_LIST } from "@ts-config-path/pages/about.astro";
import { LINKS_TO } from "@ts-config-path/styles/utilsCSS";

const { title } = Astro.props;
---

<section class="mb-10">
  <h2 class="text-2xl font-semibold my-5">{title}</h2>
  <ul class="flex flex-col gap-y-2">
    <li class={BULLET_SQUARE_LIST.li}>
      <span class={BULLET_SQUARE_LIST.span}></span>
      <a
        class={LINKS_TO}
        href="/resources-files/cheatsheet/figuratenum/figuratenum-python-cheatsheet.pdf"
        target="_blank"
        rel="noopener"
      >
        FigurateNum Python Cheatsheet - PDF
      </a>
    </li>
    <li class={BULLET_SQUARE_LIST.li}>
      <span class={BULLET_SQUARE_LIST.span}></span>
      <a
        href="/resources-files/cheatsheet/figuratenum/figuratenum-python-cheatsheet.tex"
        download="figuratenum-python-cheatsheet.tex"
        class={LINKS_TO}
        target="_blank"
        rel="noopener"
      >
        FigurateNum - Download LaTeX File
      </a>
    </li>
  </ul>
</section>
