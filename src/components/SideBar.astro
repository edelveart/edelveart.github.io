---
import SideBarMenu from "@components/SideBarMenu.astro";
import PhotoProfile from "@components/img-components/PhotoProfile.astro";
import LinkIconsGroup from "@components/LinkIconsGroup.astro";

const { menuItems, mobile = false } = Astro.props;
---

{
  mobile ? (
    <div class="drawer-side z-40">
      <label for="my-drawer" class="drawer-overlay" />

      <aside class="w-72 min-h-full bg-base-100 flex flex-col px-2">
        {" "}
        <div class="w-fit mx-auto mt-12 mb-6">
          <PhotoProfile class="w-24 avatar" />
        </div>
        <SideBarMenu menuItems={menuItems} />
        <footer class="footer footer-center flex gap-x-2  justify-center items-center mt-auto mb-6">
          <LinkIconsGroup />
        </footer>
      </aside>
    </div>
  ) : (
    <div class="hidden xl:block w-72 shrink-0 sticky top-16 h-[calc(100vh-5rem)]">
      <aside class=" h-full  bg-base-100  flex flex-col px-3">
        <div class="w-fit mx-auto pt-12 mb-6">
          <PhotoProfile class="avatar w-24" />
        </div>

        <SideBarMenu menuItems={menuItems} />

        <footer class="footer footer-center flex gap-x-2 justify-center items-center mt-auto mb-2">
          <LinkIconsGroup />
        </footer>
      </aside>
    </div>
  )
}
