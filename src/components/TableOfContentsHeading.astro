import type { MarkdownHeading } from "astro";

interface Props {
  heading: MarkdownHeading;
}

const {
  heading: { depth, slug, text },
} = Astro.props;
---

<li class="flex items-stretch">
  <div class="flex items-stretch">
    {
      Array.from({ length: depth - 1 }, () => (
        <div class="toc-lines flex flex-col items-stretch">
          <span class="top-box w-4 xl:w-3 basis-4 border-b border-base-content/20 xl:border-base-content/20" />
          <span class="bottom-box w-4 min-h-1/2 xl:w-3 flex-1 border-t border-base-content/20 xl:border-base-content/20" />
        </div>
      ))
    }
  </div>

  <a
    class="inline-block line-clamp-2 ml-3 xl:ml-2 py-1 ps-1 no-underline text-sm"
    href={`#${slug}`}
  >
    {text}
  </a>
</li>

<style>
  .toc-lines:first-child span {
    border-left-width: 1px;
  }
  li:last-child .toc-lines:first-child span.bottom-box {
    border-left-width: 0 !important;
  }
</style>
