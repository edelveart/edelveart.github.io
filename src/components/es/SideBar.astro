---
import SideBarMenu from "@components/es/SideBarMenu.astro";
import PhotoProfile from "@components/img-components/PhotoProfile.astro";
import LinkIconsGroup from "@components/LinkIconsGroup.astro";
import { menuSpanish } from "@ts-config-path/lib/menu";
const { mobile = false } = Astro.props;
---

{
  mobile ? (
    <div class="drawer-side z-40">
      <label for="my-drawer" class="drawer-overlay" />

      <aside class="w-72 min-h-full bg-base-100 flex flex-col px-2">
        <div class="w-fit mx-auto mt-12 mb-6">
          <PhotoProfile class="w-32 avatar m-auto" />
        </div>

        <SideBarMenu items={menuSpanish} />

        <footer class="footer footer-center flex justify-center-safe gap-x-1 items-center pt-0 mt-auto mb-6">
          <LinkIconsGroup />
        </footer>
      </aside>
    </div>
  ) : (
    <div
      class="
      hidden xl:block
      w-72
      shrink-0
      sticky
      top-14
      h-[calc(100vh-4rem)]
      "
    >
      <aside
        class="
        h-full
        bg-base-100
        flex flex-col
        px-2
        "
      >
        <div class="w-fit mx-auto pt-12 mb-6">
          <PhotoProfile class="w-32 avatar m-auto" />
        </div>

        <SideBarMenu items={menuSpanish} />

        <footer class="footer footer-center flex justify-center-safe gap-x-1 items-center pt-0 mt-auto mb-6">
          <LinkIconsGroup />
        </footer>
      </aside>
    </div>
  )
}
