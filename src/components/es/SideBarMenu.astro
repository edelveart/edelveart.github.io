---
const { items } = Astro.props;

import { isExactActive, isSectionActive } from "@ts-config-path/lib/routes";
import { sideMenuCss, menuClass } from "@styles/menuCSS"; // only CSS
const current = Astro.url.pathname;
---

<div class="flex flex-col w-full h-full mb-5">
  <ul class="w-full h-full flex-1 flex flex-col p-2">
    {
      items.map((item: any) => {
        const Icon = item.icon;

        const active =
          item.activeType === "section"
            ? isSectionActive(current, item.href)
            : isExactActive(current, item.href);

        return (
          <li>
            <a class={menuClass(active)} href={item.href}>
              <span class={sideMenuCss.iconBox}>
                <Icon />
              </span>

              <span class={sideMenuCss.spanText}>{item.text}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</div>
