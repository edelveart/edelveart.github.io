---
import { transitionMenu } from "@styles/menuCSS";
import { DRAWER_BREAKPOINTS } from "@styles/utilsCSS";

const currentLang = Astro.url.pathname.startsWith("/es") ? "es" : "en";

const langClass = (active: boolean) =>
  `
  flex items-center gap-2 no-underline
  ${
    active
      ? "text-primary font-medium"
      : "text-neutral-content hover:text-primary"
  }
  ${transitionMenu}
  `;

const glassEffect = "bg-base-100/50 backdrop-blur-md relative";
const marginSolved = "my-5";
const NAME_ID = "Edgar Delgado";
---

<!-- MOBILE VIEW -->
<div
  class=`sticky ${DRAWER_BREAKPOINTS.headerMobile} top-0 z-30 w-full ${glassEffect}`
>
  <div
    class="navbar w-full flex items-center justify-between md:px-5 sm:px-3 px-6"
  >
    <!-- LEFT -->
    <div class="navbar-start flex items-center">
      <label
        for="my-drawer"
        class={`flex items-center text-neutral-content hover:text-primary cursor-pointer no-underline ${transitionMenu}`}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          width="16"
          height="20"
          viewBox="0 0 16 20"
          class="stroke-current"
        >
          <path
            stroke-linecap="square"
            stroke-linejoin="round"
            stroke-width="2.2"
            d="M0 4h15M0 10h15M0 16h15"
          >
          </path>
        </svg>
      </label>
    </div>
    <!-- CENTER -->
    <div class="navbar-center">
      <a
        href={currentLang === "en" ? "/" : "/es/"}
        class={`font-semibold text-neutral-content hover:text-primary text-sm tracking-wide ${transitionMenu}`}
      >
        {NAME_ID}
      </a>
    </div>

    <!-- RIGHT -->
    <div class="navbar-end flex items-center text-xs tracking-wide">
      {
        currentLang === "es" ? (
          <a
            class={langClass(false)}
            href="/"
            title="Switch to English"
            aria-label="Switch to English"
          >
            ENG
          </a>
        ) : (
          <a
            class={langClass(false)}
            href="/es/"
            title="Cambiar a Español"
            aria-label="Cambiar a Español"
          >
            ESP
          </a>
        )
      }
    </div>
  </div>
  <!-- // PROBLEM WITH STICKY -->
  <div class="absolute bottom-0 left-0 w-full h-px bg-primary/8"></div>
</div>

<!-- PC VIEW -->
<div
  class={`${DRAWER_BREAKPOINTS.headerPC} items-center justify-between sticky top-0 z-30 px-8 h-16 ${glassEffect}`}
>
  <!-- LEFT -->
  <div class=`flex items-center ${marginSolved}`>
    <a
      href={currentLang == "en" ? "/" : "/es/"}
      class=`no-underline text-neutral-content hover:text-primary font-semibold tracking-wide ${transitionMenu}`
    >
      {NAME_ID}
    </a>
  </div>

  <!-- RIGHT -->
  <div class=`flex items-center gap-3 text-sm  ${marginSolved}`>
    <a href="/" class={langClass(currentLang === "en")}>
      <!-- <span class={`${englishFlag}`}></span> -->
      English
    </a>
    <span class="text-neutral-content">·</span>
    <a href="/es/" class={langClass(currentLang === "es")}>
      <!-- <span class={`${spanishFlag}`}></span> -->
      Español
    </a>

    <!-- future -->
    <!-- <ThemeToggle /> -->
  </div>
  <div class="absolute bottom-0 left-0 w-full h-px bg-primary/8"></div>
</div>
