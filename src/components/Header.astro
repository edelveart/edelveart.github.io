---
import HeaderMenu from "@components/HeaderMenu.astro";
import LanguageSwitcher from "@components/LanguageSwitcher.astro";
import { menuEnglish } from "@ts-config-path/lib/menu";
import { transitionMenu } from "@styles/menuCss";

const currentLang = Astro.url.pathname.startsWith("/es") ? "es" : "en";

const glassEffect = "bg-base-100/50 backdrop-blur-md border-b border-primary/8";
---

<!-- DESKTOP HEADER -->
<div
  class={`hidden xl:flex items-center justify-center gap-x-8 sticky top-0 z-30 ${glassEffect}`}
>
  <HeaderMenu items={menuEnglish} />
  <LanguageSwitcher />
</div>

<!-- MOBILE HEADER -->
<div class={`xl:hidden sticky top-0 z-30 w-full ${glassEffect}`}>
  <div
    class="navbar w-full flex items-center justify-between md:px-5 sm:px-3 px-6"
  >
    <!-- LEFT: Drawer -->
    <div class="navbar-start flex items-center">
      <label
        for="my-drawer"
        class={`flex items-center gap-2 text-neutral-content hover:text-primary cursor-pointer no-underline ${transitionMenu}`}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          width="16"
          height="20"
          viewBox="0 0 16 20"
          class="stroke-current"
        >
          <path
            stroke-linecap="square"
            stroke-linejoin="round"
            stroke-width="2.2"
            d="M0 4h15M0 10h15M0 16h15"
          >
          </path>
        </svg>

        <span>
          {currentLang === "es" ? "Menú" : "Menu"}
        </span>
      </label>
    </div>

    <!-- RIGHT: Language -->
    <div class="navbar-end flex items-center">
      <LanguageSwitcher />
    </div>
  </div>
</div>
