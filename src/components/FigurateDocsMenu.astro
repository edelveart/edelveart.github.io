---
// type Props = {};

// REPLACE SIDEBARIDACTIVEITEM
import { getCollection } from "astro:content";
import createSlug from "@ts-config-path/lib/createSlug";
import { isExactActive, isSectionActive } from "@ts-config-path/lib/routes";
import { sideMenuCss, transitionMenu } from "@styles/menuCss";
const current = Astro.url.pathname;
const figuratePosts = await getCollection("figurate");
const sortedFigurate = figuratePosts.sort(
  (a, b) => a.data.order - b.data.order,
);

const figurateLinks = sortedFigurate.map((post) => {
  const href = "/figuratenum/" + createSlug(post.data.title, post.id) + "/";
  return {
    title: post.data.title,
    href,
    active: isExactActive(current, href),
  };
});
---

<div class="flex flex-col w-full mb-5">
  <!-- CONDITIONAL SUBMENU OF DOCS -->
  {
    isSectionActive(current, "/figuratenum/") && (
      <li>
        <ul class="ml-2">
          {figurateLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={`
                flex pl-4 text-sm items-center h-10 rounded-md
                no-underline hover:text-primary hover:opacity-100 ${transitionMenu}
                ${link.active ? `${sideMenuCss.active} opacity-100` : "opacity-80"}
              `}
              >
                <span class="min-w-0 flex-1 truncate whitespace-nowrap text-sm">
                  {link.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </li>
    )
  }
</div>
