---
import { allProjects } from "@components/ProjectsComponent.astro";
import { Image } from "astro:assets";
import { BORDER_OPACITY, SPACES_BETWEEN_CARDS, GET_COLORS_METADATA } from "@styles/utilsCSS";

import MainFigurateNumWebp from "@assets/main-figuratenum.webp";
import MainTonnetzWebp from "@assets/main-tonnetz.webp";
import MainModularWebp from "@assets/main-modular.webp";

const cardBase = `
  block relative w-full
  p-0
  ${BORDER_OPACITY}
  overflow-hidden
  aspect-[16/8]
  lg:aspect-auto
`;

const badge = `
  absolute top-0 left-0
  m-2 p-1
  bg-base-100
  rounded-sm
  ${GET_COLORS_METADATA("cardsImg")}
  text-xs
  z-5
`;
---

<!-- https://svgomg.net/ --><!-- https://vecta.io/nano -->
<section
  class={`grid
    grid-cols-1
    lg:grid-cols-3
    ${SPACES_BETWEEN_CARDS.GAP}
    lg:auto-rows-fr`}
>
  <!-- 1 — FIGURATENUM / GRANDE -->
  <a
    href={allProjects[2].url}
    target="_blank"
    rel="noopener noreferrer"
    class={`${cardBase} lg:col-span-2 lg:row-span-2`}
  >
    <div class={badge}>
      <span>FIGURATENUM</span>
      <!-- <span>FigurateNum • PyPI</span> -->
    </div>

    <Image
      src={MainFigurateNumWebp}
      class="w-full
        h-full
        object-cover
        object-center"
      format="webp"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      alt="FigurateNum library - Phase Portrait"
    />
  </a>

  <!-- 2 — MODULAR FORMS -->
  <a
    href={allProjects[1].url}
    target="_blank"
    rel="noopener noreferrer"
    class={`${cardBase} lg:col-span-1`}
  >
    <div class={badge}>
      <span>MODULAR FORMS</span>
      <!-- <span>Modular Forms • RubyGems</span> -->
    </div>

    <Image
      src={MainModularWebp}
      class="w-full
        h-full
        object-cover
        object-center
        invert
        hue-rotate-270"
      format="webp"
      loading="lazy"
      decoding="async"
      alt="Math-Modular-Elliptic-Image"
    />
  </a>

  <!-- 3 — TS-TONNETZ -->
  <a
    href={allProjects[0].url}
    target="_blank"
    rel="noopener noreferrer"
    class={`${cardBase} lg:col-span-1`}
  >
    <div class={badge}>
      <span>TS-TONNETZ</span>
      <!-- <span>TS-Tonnetz • npm</span> -->
    </div>

    <Image
      src={MainTonnetzWebp}
      class="w-full
        h-full
        object-cover
        object-center
        invert
        hue-rotate-180"
      format="webp"
      decoding="async"
      loading="lazy"
      alt="ts-tonnetz simplices portrait"
    />
  </a>
</section>
