---
import { allProjects } from "@components/ProjectsComponent.astro";
import { Image } from "astro:assets";
import { BORDER_OPACITY, GET_COLORS_METADATA } from "@styles/utilsCSS";

const divisor = "my-5";
const UrlArray = allProjects;

const cardDisplay = "aspect-[16/8]";
const imagePadding = "p-0";
const cardBase = `
  block relative w-full ${cardDisplay}
  max-h-72
  ${imagePadding}
  ${BORDER_OPACITY}
  transition-shadow
  shadow-sm
  shadow-base-300/15
  hover:shadow-primary/20

`;

const badge = `absolute top-0 left-0 m-4 p-1 bg-base-100 rounded-sm ${GET_COLORS_METADATA("cardsImg")} text-xs z-5`;

import MainFigurateNumImage from "@assets/main-figuratenum.webp";
import MainTonnetzImage from "@assets/main-tonnetz.webp";
import MainModularImage from "@assets/main-modular.webp";
---

<!-- https://svgomg.net/  --><!-- https://vecta.io/nano -->
<div class={divisor}></div>
<a
  href={UrlArray[2].url}
  target="_blank"
  rel="noopener noreferrer"
  class={cardBase}
>
  <div class={badge}>
    <span>FigurateNum • PyPI</span>
  </div>

  <Image
    src={MainFigurateNumImage}
    class="w-full h-full object-cover"
    width={400}
    height={260}
    format="webp"
    fetchpriority="high"
    loading="eager"
    alt="FigurateNumber - Phase Portrait"
  />
</a>

<div class={divisor}></div>

<section class="grid grid-cols-1 lg:grid-cols-2 gap-x-4 gap-y-5">
  <!-- // 1 -->
  <a
    href={UrlArray[1].url}
    target="_blank"
    rel="noopener noreferrer"
    class={cardBase}
  >
    <div class={badge}>
      <span>Modular Forms • RubyGems</span>
    </div>
    <Image
      src={MainModularImage}
      class={`w-full h-full object-cover invert hue-rotate-270`}
      width={400}
      height={280}
      format="webp"
      loading="lazy"
      fetchpriority="low"
      alt="Math-Modular-Elliptic-Image"
    />
  </a>
  <!-- // 2 -->
  <a
    href={UrlArray[0].url}
    target="_blank"
    rel="noopener noreferrer"
    class={cardBase}
  >
    <div class={badge}>
      <span>TS-Tonnetz • npm</span>
    </div>
    <Image
      src={MainTonnetzImage}
      alt="ts-tonnetz simplices portrait"
      class={`w-full h-full object-cover invert  hue-rotate-180`}
      format="webp"
      width={400}
      height={280}
      loading="lazy"
      fetchpriority="low"
    />
  </a>
</section>
