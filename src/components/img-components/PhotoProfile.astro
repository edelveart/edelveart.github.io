---
import { Image } from "astro:assets";
import MyPic from "../../assets/prof-webp/edelve-pic.webp";
const { class: className = "" } = Astro.props;
---

<div class="drop-shadow-md drop-shadow-base-300/15">
  <div class="mask mask-squircle bg-base-content/12 p-px">
    <Image
      class={`mask mask-squircle ${className}`}
      width={50}
      height={50}
      priority
      format="webp"
      src={MyPic}
      alt="Profile Photo of Edgar Delgado Vega"
    />
  </div>
</div>
