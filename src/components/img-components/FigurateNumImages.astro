---
import { Image } from "astro:assets";
import discreteAndContinuousPortraits from "../../assets/libraries-webp/discrete-continuous-portraits.webp";
import Math from "@components/Math.astro";
import { BASE_BORDER_IMG } from "@styles/utilsCSS";
---

<figure class="text-center my-10 text-base-content/80">
  <Image
    class=`p-3 ${BASE_BORDER_IMG}`
    src={discreteAndContinuousPortraits}
    alt="Picture of 5D Hyperoctahedron (Discrete and Continuous)"
    loading="lazy"
    format="webp"
  />
  <figcaption class="mt-6 text-sm text-base-content/80">
    <span>
      5D Figurate Number Hyperoctahedron: discrete pattern in {" "}
      <Math tex={String.raw`\mathbb{Z}/n\mathbb{Z}`} /> (left) versus continuous meromorphic
      representations in <Math tex={String.raw`\mathbb{C}`} /> (center and right)
    </span>
  </figcaption>
</figure>
