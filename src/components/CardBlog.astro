---
import { Image } from "astro:assets";
const {
  title,
  heroImage,
  desc,
  url,
  badge,
  pubDate,
  tags,
  target = "_blank",
} = Astro.props;
// const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";

// PubDATE from md files
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll");
import { BORDER_OPACITY, CARD_OP, GET_COLORS_METADATA, BASE_BORDER_IMG } from "@styles/utilsCSS";
// console.log("CARD HERO:", heroImage);
---

<a
  href={url}
  target={target}
  class=`group flex ${BORDER_OPACITY} p-4 my-4 mx-auto flex-col`
>
  <h2
    class=`${CARD_OP.title} group-hover:text-primary line-clamp-2 md:line-clamp-none transition-colors`
  >
    {title}
  </h2>

  <div class="flex items-center gap-2 mt-1">
    <span class={CARD_OP.muteData}>{displayDate}</span>
    <span class={CARD_OP.muteData}>·</span>

    <span class={GET_COLORS_METADATA(badge)}>
      {badge}
    </span>
  </div>
  {
    heroImage && (
      <div class="flex justify-center">
        <Image
          src={heroImage}
          alt={title}
          class=`my-2 rounded-sm max-w-56 max-h-48  ${BASE_BORDER_IMG}`
          height={240}
          width={320}
        />
      </div>
    )
  }

  <p class=`mt-2 ${CARD_OP.parr} md:line-clamp-none line-clamp-2`>
    {desc}
  </p>
</a>

