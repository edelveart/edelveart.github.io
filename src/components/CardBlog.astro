---
import { Image } from "astro:assets";
import { CARD_OP, GET_COLORS_METADATA } from "@styles/utilsCSS";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

const {
  title,
  heroImage,
  desc,
  url,
  badge,
  pubDate,
  updatedDate,
  target = "_self",
} = Astro.props;

dayjs.extend(localizedFormat);
const displayDate = pubDate ? dayjs(pubDate).format("ll") : null;
---

<a
  href={url}
  target={target}
  class:list={[
    "group block mx-auto border-b border-base-content/10",
    "py-5 first:pt-2 last:border-b-0",
    "transition-colors ",
  ]}
>
  <div class="flex items-center gap-4 sm:gap-6">
    <!-- IMAGE -->
    {heroImage && (
      <div class="w-28 sm:w-40 md:w-48 shrink-0 flex items-center justify-center">
        <Image
          src={heroImage}
          alt={title}
          class="w-full h-auto max-h-32 sm:max-h-36 md:max-h-40 object-contain rounded-md transition-transform duration-300 group-hover:scale-[1.03]"
          loading="lazy"
        />
      </div>
    )}

    <!-- CONTENT -->
    <div class="min-w-0 flex-1 flex flex-col">
      <!-- METADATA -->
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-0.5">
        {displayDate && (
          <span class={`${CARD_OP.muteData} whitespace-nowrap`}>{displayDate}</span>
        )}

        {badge && (
          <>
            <span class="text-base-content/40">·</span>
            <span class={GET_COLORS_METADATA(badge)}>{badge}</span>
          </>
        )}
      </div>

      <!-- TITLE -->
      <h2
        class={`${CARD_OP.title} line-clamp-2 transition-colors group-hover:text-primary`}
      >
        {title}
      </h2>

      <!-- DESCRIPTION -->
      {desc && <p class={`${CARD_OP.parr} mt-1.5 line-clamp-5`}>{desc}</p>}

      <!-- UPDATED DATE -->
      {updatedDate && (
        <span class={`${CARD_OP.muteData} mt-2 text-xs`}>
          Updated {dayjs(updatedDate).format("ll")}
        </span>
      )}
    </div>
  </div>
</a>
