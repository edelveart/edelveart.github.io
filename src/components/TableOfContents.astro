<script>
  function initTOC() {
    const anchors = document.querySelectorAll("h2[id], h3[id]");
    const links = document.querySelectorAll("details.toc > nav > ul > li");

    if (anchors.length !== links.length || anchors.length === 0) {
      return;
    }

    function updateActiveHeading() {
      const scrollTop = window.scrollY;
      const viewportHeight = window.innerHeight;
      const documentHeight = document.documentElement.scrollHeight;

      const isAtBottom =
        Math.ceil(scrollTop + viewportHeight) >= documentHeight - 20;

      let highlighted = false;

      if (isAtBottom) {
        links[links.length - 1].classList.add("active-heading");

        for (let i = 0; i < links.length - 1; i++) {
          links[i].classList.remove("active-heading");
        }

        return;
      }

      const activationOffset = 150;

      for (let i = anchors.length - 1; i >= 0; i--) {
        const anchor = anchors[i] as HTMLElement;

        if (!highlighted && scrollTop > anchor.offsetTop - activationOffset) {
          links[i].classList.add("active-heading");
          highlighted = true;
        } else {
          links[i].classList.remove("active-heading");
        }
      }
    }

    window.addEventListener("scroll", updateActiveHeading, {
      passive: true,
    });

    window.addEventListener("resize", updateActiveHeading);

    updateActiveHeading();
  }

  initTOC();

  document.addEventListener("astro:page-load", initTOC);
</script>
