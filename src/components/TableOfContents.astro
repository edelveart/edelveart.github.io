import type { MarkdownHeading } from "astro";
import TOCHeading from "./TableOfContentsHeading.astro";
import Arrow from "@icons/Arrows.astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const filteredHeadings = headings.filter(
  ({ depth }) => depth >= 2 && depth <= 3,
);
---

<details open class="not-prose toc group relative">
  <summary
    class="list-none marker:hidden cursor-pointer flex items-center gap-2
           text-neutral-content hover:text-primary
           transition-colors duration-150"
  >
    <span class="text-sm font-medium tracking-wide">Table of Contents</span>

    <span class="group-open:rotate-180 transition-transform duration-150">
      <Arrow direction="down" size="xs" />
    </span>
  </summary>

  <nav class="w-full xl:max-h-[calc(100vh-4rem)] xl:overflow-y-auto">
    <ul class="mt-1 flex max-w-full flex-col">
      {filteredHeadings.map((heading) => <TOCHeading heading={heading} />)}
    </ul>
  </nav>
</details>

