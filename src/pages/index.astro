---
import BaseLayout from "@layouts/BaseLayout.astro";

import Biography from "@components/Biography.astro";
import Experience from "../components/Experience.astro";
import CardBlog from "@components/CardBlog.astro";
// BLOG - NOTES
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";
import PreviousPosts from "@components/PreviousPosts.astro";
import { SPACES_BETWEEN_CARDS } from "@styles/utilsCSS";
import LinkIconsGroup from "@components/LinkIconsGroup.astro";

// const posts = (await getCollection("blog")).sort(
//   (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
// );

// ONLY ENGLISH NOTES
const posts = (await getCollection("blog"))
  .filter((post) => post.data.lang !== "es")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 4);
---

<BaseLayout title="Edgar Delgado Vega | Creative Math Systems">
  <section class="pb-3 mt-5">
    <h2 class="text-xs uppercase tracking-wider font-medium text-secondary/85 mb-2.5">
      Creative Math Systems Developer
    </h2>
    <h1 class="text-4xl font-bold leading-snug">Edgar Delgado</h1>
    <LinkIconsGroup />
    <!-- BIO -->
    <div class="mt-6 mb-12">
      <Biography />
      <!-- <MainLinks contactText="LinkedIn" linkedin="L" github="G" youtube="Y" /> -->
    </div>
    <!-- BLOG-NOTES -->
    <div class="flex justify-between items-center gap-2 my-8">
      <h2 class="text-3xl font-bold">Notes</h2>
      <div>
        <PreviousPosts />
      </div>
    </div>
    <div class={`grid grid-cols-1 sm:grid-cols-2 ${SPACES_BETWEEN_CARDS.GAP}`}>
      {last_posts.map((post) => (
        <CardBlog
          pubDate={post.data.pubDate}
          title={post.data.title}
          badge={post.data.badge}
          heroImage={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.id) + "/"}
          target="_self"
        />
      ))}
    </div>

    <div class="mb-14"></div>
    <Experience indices={[0, 1]} />
  </section>
</BaseLayout>
