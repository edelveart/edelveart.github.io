---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectsComponent, {
  allProjects,
} from "@components/ProjectsComponent.astro";
---

<BaseLayout title="Edgar Delgado Vega - Software Projects">
  <section class="pb-3 mt-5">
    <ProjectsComponent
      headTitle="Software"
      projects={allProjects}
      order={[
        "figuratenum-python",
        "figurate-numbers-ruby",
        "fignumbers-ts",
        "modular-forms",
        "topos",
        "ts-tonnetz",
        "figurate-numbers-lua",
      ]}
    />
  </section>
</BaseLayout>
