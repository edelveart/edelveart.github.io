---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import createSlug from "@ts-config-path/lib/createSlug";
import Arrows from "@icons/Arrows.astro";
import {
  BORDER_INFO,
  NAV_LINKS_PAGES,
  GET_COLORS_METADATA,
  BASE_BORDER,
} from "@styles/utilsCSS";
import DividerNav from "@components/DividerNav.astro";

const metadataLinks = [
  {
    label: "PyPI",
    href: "https://pypi.org/project/figuratenum/",
  },
  {
    label: "Source Repository",
    href: "https://github.com/edelveart/figuratenum",
  },
  {
    label: "DOI (Zenodo)",
    href: "https://doi.org/10.5281/zenodo.18250313",
  },
];

// DOCS
const docs = await getCollection("figurate");
// const sortedDocs = docs.sort((a, b) => a.data.order - b.data.order);
const docsMap = Object.fromEntries(docs.map((d) => [d.data.title, d]));
const OVERVIEW = docsMap["Getting Started"];
const THEORY = docsMap["Fundamentals"];
const API = docsMap["API: PlaneFigurateNum"];
const CONTRIBUTING = docsMap["Contributing"];

const docsCards = [
  {
    title: "Learn from Scratch",
    description:
      "Start with sequence generation and work through parametric families, higher dimensions, and visualization tools.",
    doc: OVERVIEW,
    button: "Start here",
  },
  {
    title: "Mathematical Theory",
    description:
      "Explore the basic definitions, notation, and core ideas behind figurate numbers and their geometric interpretations.",
    doc: THEORY,
    button: "Explore theory",
  },
  {
    title: "API Reference",
    description:
      "Auto-generated reference for all sequence generators, ComplexViz, and DiscreteViz, organized by dimension.",
    doc: API,
    button: "View API",
  },
  {
    title: "Contributing",
    description:
      "Run tests, add new sequences, correct mathematical errata, and submit pull requests.",
    doc: CONTRIBUTING,
    button: "Contribute",
  },
];

// BLOG
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
dayjs.extend(localizedFormat);
const blog = await getCollection("blog");
const blogMap = Object.fromEntries(blog.map((post) => [post.data.title, post]));
const figurateNumTitles = [
  "Two Years Leading to FigurateNum v3 Visualizations in the Complex Plane",
  "Gamma Functions for Figurate Numbers",
  "Generators as Symbolic Exploration",
  "My Journey with Figurate Numbers",
];

const figurateNumPosts = figurateNumTitles
  .map((title) => blogMap[title])
  .filter(Boolean);

import { LINKS_TO, CARD_OP, BORDER_OPACITY } from "@styles/utilsCSS";
import { BULLET_SQUARE_LIST } from "../about.astro";
const CARD_BUTTONS = {
  container: `p-4 flex flex-col h-full min-h-52 ${BASE_BORDER}`,
  title: `${CARD_OP.title}`,
  paragraps: `mt-2 mb-4 ${CARD_OP.parr}`,
  btns: `flex items-center justify-center h-12 mt-auto
    text-sm font-normal
    ${BORDER_OPACITY}
    hover:text-primary
    no-underline`,
};
---

<BaseLayout
  title="Edgar Delgado - FigurateNum Documentation"
  sideBarActiveItemID="FIGURATENUM_ACTIVE_PAGE"
>
  <article class="pb-3 mt-5">
    <h1
      class="text-3xl font-bold flex flex-col md:flex-row md:items-center mb-4"
    >
      <div class="flex flex-col md:flex-row md:items-center">
        <div>FigurateNum</div>
        <div
          class="md:ml-2 translate-y-px text-lg uppercase tracking-wider text-primary/80"
        >
          <span class="hidden md:inline text-base-content/60">
            {" "}·{" "}
          </span>
          <span class="font-light">Documentation</span>
        </div>
      </div>
    </h1>

    <div class={`flex flex-wrap gap-x-4 gap-y-2 ${BORDER_INFO}`}>
      {
        metadataLinks.map((link) => (
          <a
            class={GET_COLORS_METADATA("tags")}
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <p class="mb-4 mt-10">
      <strong>FigurateNum</strong> generates and visualizes 235+ plane, space, and
      multidimensional figurate number sequences and families, from polygonal numbers
      to Platonic solids and higher-dimensional analogues.
    </p>

    <p class="mt-3 mb-4">
      Built on definitions from <a
        class={LINKS_TO}
        href="https://doi.org/10.1142/8188"
        target="_blank"
        rel="noopener noreferrer"
      >
        Deza & Deza (2012)
      </a>, every sequence is deterministic and reproducible. Optional
      visualization tools cover phase portraits and modular patterns.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-4 mt-10">
      {
        docsCards.map(
          (card) =>
            card.doc && (
              <div class={CARD_BUTTONS.container}>
                <h2 class={CARD_BUTTONS.title}>{card.title}</h2>
                <p class={CARD_BUTTONS.paragraps}>{card.description}</p>
                <a
                  class={CARD_BUTTONS.btns}
                  href={`/figuratenum/${createSlug(card.doc.data.title, card.doc.id)}/`}
                >
                  {card.button}
                  <span class="ml-2">
                    <Arrows direction="right" />
                  </span>
                </a>
              </div>
            ),
        )
      }
    </div>

    <h2
      class="mt-12 text-2xl font-semibold flex flex-col md:flex-row md:items-center"
    >
      <div>FigurateNum</div>
      <div
        class="md:ml-2 translate-y-px text-lg uppercase tracking-wider text-primary/80"
      >
        <span class="hidden md:inline text-base-content/60">
          {" "}·{" "}
        </span>
        <span class="font-light">Notes</span>
      </div>
    </h2>

    <ul class="mt-6">
      {
        figurateNumPosts.map((post) => (
          <li class={`${BULLET_SQUARE_LIST.li} mt-2 `}>
            <span class={BULLET_SQUARE_LIST.span} />
            <a href={`/blog/${createSlug(post.data.title, post.id)}/`}>
              <span class={LINKS_TO}>{post.data.title}</span>
              <span class={`${CARD_OP.muteData} block md:inline`}>
                <span class="hidden md:inline"> · </span>
                {dayjs(post.data.pubDate).format("ll")}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </article>

  <DividerNav />

  <div class="grid grid-cols-1 gap-2">
    {
      OVERVIEW && (
        <a
          class={`${NAV_LINKS_PAGES.aLink} justify-end`}
          href={
            "/figuratenum/" + createSlug(OVERVIEW.data.title, OVERVIEW.id) + "/"
          }
        >
          <div class="text-right">
            <div class={NAV_LINKS_PAGES.prevNext}>NEXT</div>

            <div class={NAV_LINKS_PAGES.pageTitle}>{OVERVIEW.data.title}</div>
          </div>

          <span class={NAV_LINKS_PAGES.arrowSpan}>
            <Arrows direction="right" />
          </span>
        </a>
      )
    }
  </div>
</BaseLayout>
