---
import BaseLayout from "@layouts/es/BaseLayout.astro";
import { getCollection } from "astro:content";
import createSlug from "@ts-config-path/lib/createSlug";
import CardBlog from "@components/CardBlog.astro";
import Arrows from "@icons/Arrows.astro";
import DividerNav from "@components/DividerNav.astro";
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import {
  NAV_LINKS_PAGES,
  BORDER_INFO,
  GET_COLORS_METADATA,
} from "@styles/utilsCSS";
import { routeEnglish } from "@ts-config-path/lib/menu";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection("blog", ({ data }) => data.lang === "es");
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 8 });
};

export type Props = {
  page: {
    data: CollectionEntry<"blog">[];
    currentPage: number;
    url: {
      current: string;
      prev?: string;
      next?: string;
    };
  };
};

const { page } = Astro.props as Props;
---

<BaseLayout
  title="Edgar Delgado - Notes"
  sideBarActiveItemID="NOTES_ACTIVE_PAGE"
>
  <article class="pb-3 mt-5">
    <div class="flex w-full items-start justify-between gap-2">
      <h2 class="shrink-0 text-3xl font-bold">Notas</h2>

      <a
        class={`${NAV_LINKS_PAGES.aLink} ${NAV_LINKS_PAGES.nextRight} flex max-w-[65%] items-start`}
        href={routeEnglish.archive}
      >
        <span
          class={`${NAV_LINKS_PAGES.pageTitle} min-w-0 text-right text-sm text-neutral-content`}
        >
          Ver todas las publicaciones
        </span>

        <span class={`${NAV_LINKS_PAGES.arrowSpan}`}>
          <Arrows direction="right" size="sm" />
        </span>
      </a>
    </div>

    {
      page.currentPage === 1 && (
        <section class={`grid gap-4 sm:grid-cols-2 ${BORDER_INFO} mt-5`}>
          <div>
            <h3 class={GET_COLORS_METADATA("field notes")}>Notas de campo</h3>
            <p class="text-sm">
              Experimentos completados, implementaciones y reflexiones en torno
              a proyectos en curso.
            </p>
          </div>

          <div>
            <h3 class={GET_COLORS_METADATA("lab notes")}>
              Notas de laboratorio
            </h3>
            <p class="text-sm">
              Exploraciones en profundidad de conceptos, estructuras e ideas
              matemáticas y musicales.
            </p>
          </div>

          <div>
            <h3 class={GET_COLORS_METADATA("sketch notes")}>Notas de boceto</h3>
            <p class="text-sm">
              Ideas iniciales, caminos inacabados y preguntas sobre matemáticas
              y música que sigo explorando.
            </p>
          </div>

          <div>
            <h3 class={GET_COLORS_METADATA("misc notes")}>Notas diversas</h3>
            <p class="text-sm">
              Notas personales sobre herramientas, prácticas creativas,
              programación en vivo, música, humanidades y otros ámbitos de
              interés.
            </p>
          </div>
        </section>
      )
    }

    {
      page.data.length === 0 ? (
        <div class={`bg-base-200 ${BORDER_INFO} w-full p-4 min-w-full`}>
          <p class="font-bold">Sorry!</p>
          <p>
            There are no blog posts to show at the moment. Check back later!
          </p>
        </div>
      ) : (
        <div class="mt-10">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {page.data.map((post) => (
              <CardBlog
                title={post.data.title}
                url={"/es/blog/" + createSlug(post.data.title, post.id) + "/"}
                heroImage={post.data.heroImage}
                desc={post.data.description}
                target="_self"
                badge={post.data.badge}
                pubDate={post.data.pubDate}
                tags={post.data.tags}
              />
            ))}
          </div>
        </div>
      )
    }
  </article>
  <!-- {
    page.currentPage === 1 && (
      <section class={`text-sm mb-8 mt-12 ${BORDER_INFO}`}>
        <h3 class={GET_COLORS_METADATA("warning")}>AI Assistance</h3>
        <p class={CARD_OP.parr}>
          AI tools are used to assist with grammar and occasional discussion of ideas. Final review
          remains with the author.
        </p>
      </section>
    )
  } -->

  <DividerNav />

  <div class="grid grid-cols-2 gap-2">
    <!-- <div class="grid grid-cols-1 sm:grid-cols-2 gap-2"> -->
    {
      page.url.prev ? (
        <a
          class={`${NAV_LINKS_PAGES.aLink} ${NAV_LINKS_PAGES.prevLeft}`}
          href={page.url.prev}
        >
          <span class={NAV_LINKS_PAGES.arrowSpan}>
            <Arrows direction="left" />
          </span>

          <div>
            <div class={NAV_LINKS_PAGES.prevNext}>NUEVAS</div>
            <div class={NAV_LINKS_PAGES.pageTitle}>Notas recientes</div>
          </div>
        </a>
      ) : (
        <a
          class={`${NAV_LINKS_PAGES.aLink} ${NAV_LINKS_PAGES.prevLeft}`}
          href={"/es/"}
        >
          <span class={NAV_LINKS_PAGES.arrowSpan}>
            <Arrows direction="left" />
          </span>

          <div>
            <div class={NAV_LINKS_PAGES.prevNext}>INICIO</div>
            <div class={NAV_LINKS_PAGES.pageTitle}>Volver al inicio</div>
          </div>
        </a>
      )
    }

    {
      page.url.next ? (
        <a
          class={`${NAV_LINKS_PAGES.aLink} ${NAV_LINKS_PAGES.nextRight}`}
          href={page.url.next}
        >
          <div class="text-right">
            <div class={NAV_LINKS_PAGES.prevNext}>ANTERIORES</div>
            <div class={NAV_LINKS_PAGES.pageTitle}>Notas previas</div>
          </div>

          <span class={NAV_LINKS_PAGES.arrowSpan}>
            <Arrows direction="right" />
          </span>
        </a>
      ) : (
        <div />
      )
    }
  </div>
</BaseLayout>
