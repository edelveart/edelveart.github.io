---
import BaseLayout from "@layouts/es/BaseLayout.astro";

import BiographyES from "@components/BiographyES.astro";
import Experience from "@components/Experience.astro";
import CardBlog from "@components/CardBlog.astro";
// BLOG
import createSlug from "@ts-config-path/lib/createSlug";
import { getCollection } from "astro:content";
import PreviousPosts from "@components/PreviousPosts.astro";
import { SPACES_BETWEEN_CARDS } from "@styles/utilsCSS";
import LinkIconsGroup from "@components/LinkIconsGroup.astro";

// const posts = (await getCollection("blog")).sort(
//   (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
// );

// Only Spanish Pages
const posts = (await getCollection("blog"))
  .filter((post) => post.data.lang === "es")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 4);
---

<BaseLayout title="Edgar Delgado Vega | Sistemas Matemáticos Creativos">
  <section class="mt-5 pb-3">
    <h2 class="text-sm uppercase tracking-wider font-medium text-secondary/80 mb-1">
      Sistemas matemáticos creativos
    </h2>
    <h1 class="text-4xl font-bold leading-snug">Edgar Delgado</h1>
    <LinkIconsGroup />
    <!-- BIO -->
    <div class="mt-5 mb-12">
      <BiographyES />
    </div>
    <!-- BLOG-NOTES -->
    <div class="flex justify-between items-center gap-2 my-5">
      <h2 class="text-3xl font-bold">Notas</h2>
      <div>
        <PreviousPosts lang="es" />
      </div>
    </div>
    <div class={`grid grid-cols-1 sm:grid-cols-2 ${SPACES_BETWEEN_CARDS.GAP}`}>
      {last_posts.map((post) => (
        <CardBlog
          pubDate={post.data.pubDate}
          title={post.data.title}
          badge={post.data.badge}
          heroImage={post.data.heroImage}
          desc={post.data.description}
          url={"/es/blog/" + createSlug(post.data.title, post.id) + "/"}
          target="_self"
        />
      ))}
    </div>
    <div class="mt-12 mb-14"></div>
    <Experience lang="es" indices={[0, 1]} />
  </section>
</BaseLayout>
