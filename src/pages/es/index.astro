---
import BaseLayout from "@layouts/es/BaseLayout.astro";

import BiographyES from "@components/BiographyES.astro";
import Experience from "@components/Experience.astro";
import CardBlog from "@components/CardBlog.astro";
// BLOG
import createSlug from "@ts-config-path/lib/createSlug";
import { getCollection } from "astro:content";
import PreviousPosts from "@components/PreviousPosts.astro";
import {
  BORDER_INFO,
  LABEL_HEAD_INDEX,
  SPACES_BETWEEN_CARDS,
  GET_COLORS_METADATA,
} from "@styles/utilsCSS";
import { metadataLinks } from "@ts-config-path/config";

// Only Spanish Pages
const posts = (await getCollection("blog"))
  .filter((post) => post.data.lang === "es")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 4);
---

<BaseLayout title="Edgar Delgado Vega | Sistemas Matemáticos Creativos">
  <section>
    <h2 class={LABEL_HEAD_INDEX}>Sistemas matemáticos creativos</h2>
    <h1 class="text-4xl font-bold mb-4">Edgar Delgado</h1>

    <div class={`flex flex-wrap gap-x-4 gap-y-2`}>
      {metadataLinks.map((link) => (
        <a
          class={GET_COLORS_METADATA("tags")}
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          {link.label}
        </a>
      ))}
    </div>
    <!-- BIO -->
    <div class="mt-8 mb-12">
      <BiographyES />
    </div>
    <!-- BLOG-NOTES -->
    <div class="flex justify-between items-center gap-2 my-5">
      <h2 class="text-3xl font-bold">Notas</h2>
      <div>
        <PreviousPosts lang="es" />
      </div>
    </div>
    <div class={`${SPACES_BETWEEN_CARDS.GAP}`}>
      {last_posts.map((post) => (
        <CardBlog
          pubDate={post.data.pubDate}
          title={post.data.title}
          badge={post.data.badge}
          heroImage={post.data.heroImage}
          desc={post.data.description}
          url={"/es/blog/" + createSlug(post.data.title, post.id) + "/"}
          target="_self"
        />
      ))}
    </div>
    <div class="mt-12 mb-14"></div>
    <Experience lang="es" indices={[0, 1]} />
  </section>
</BaseLayout>
