---
import BaseLayout from "@layouts/es/BaseLayout.astro";

import MainLinks from "@components/MainLinks.astro";
import Experience from "@components/Experience.astro";
import HeroTopProjects from "@components/img-components/Hero-Top-Projects.astro";
import CardBlog from "@components/CardBlog.astro";
// BLOG
import createSlug from "@ts-config-path/lib/createSlug";
import { getCollection } from "astro:content";
import PreviousPosts from "@components/PreviousPosts.astro";
import BiographyES from "@components/BiographyES.astro";
// const posts = (await getCollection("blog")).sort(
//   (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
// );
// Only Spanish Pages
const posts = (await getCollection("blog"))
  .filter((post) => post.data.lang === "es")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout
  title="Edgar Delgado Vega - Desarrollador de sistemas matemáticos creativos"
>
  <section class="mt-5 pb-3">
    <h2
      class="text-xs uppercase tracking-wider font-semibold text-primary/85 mb-1.5"
    >
      Desarrollador de sistemas matemáticos creativos
    </h2>
    <h1 class="text-4xl font-bold leading-snug mb-10">Edgar Delgado</h1>
    <HeroTopProjects />
    <!-- BIO -->
    <div class="mt-10 mb-12">
      <BiographyES />
      <MainLinks contactText="LinkedIn" linkedin="L" github="G" youtube="Y" />
    </div>
    <!-- BLOG-NOTES -->
    <div class="flex justify-between items-center gap-2 my-8">
      <h2 class="text-3xl font-bold">Notas</h2>
      <div><PreviousPosts lang="es" /></div>
    </div>
    {
      last_posts.map((post) => (
        <>
          {/* tags={post.data.tags} */}
          {/* img={post.data.heroImage} */}
          <CardBlog
            pubDate={post.data.pubDate}
            title={post.data.title}
            badge={post.data.badge}
            heroImage={post.data.heroImage}
            desc={post.data.description}
            url={"/blog/" + createSlug(post.data.title, post.id) + "/"}
            target="_self"
          />
        </>
      ))
    }
    <div class="mb-14"></div>
    <Experience lang="es" indices={[0, 1]} />
  </section>
</BaseLayout>
