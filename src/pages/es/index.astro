---
import BaseLayout from "@layouts/es/BaseLayout.astro";

import Biography from "@components/es/Biography.astro";
import MainLinks from "@components/MainLinks.astro";
import Experience, { allExperiences } from "@components/es/Experience.astro";
import HeroTopProjects from "@components/img-components/Hero-Top-Projects.astro";
import CardBlog from "@components/CardBlog.astro";
// BLOG
import createSlug from "@ts-config-path/lib/createSlug";
import { getCollection } from "astro:content";
import PreviousPosts from "@components/PreviousPosts.astro";
import DividerNav from "@components/DividerNav.astro";
// const posts = (await getCollection("blog")).sort(
//   (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
// );
// Only Spanish Pages
const posts = (await getCollection("blog"))
  .filter((post) => post.data.lang === "es")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout
  title="Edgar Delgado Vega - Desarrollador de sistemas matemáticos creativos"
>
  <section class="mt-4">
    <h2 class="text-xs uppercase tracking-wide font-semibold text-primary mb-2">
      Desarrollador de sistemas matemáticos creativos
    </h2>

    <h1 class="text-4xl font-bold leading-snug mb-8">Edgar Delgado</h1>

    <HeroTopProjects />

    <div class="mt-10 mb-12">
      <Biography />
      <MainLinks contactText="LinkedIn" linkedin="L" github="G" youtube="Y" />
    </div>

    <Experience workExperiences={allExperiences} indices={[0, 1]} />
    <!-- BLOG-NOTES -->
    <h2 class="text-3xl w-full font-bold flex items-center mt-12 mb-10">
      Notas recientes
    </h2>
    {
      last_posts.map((post) => (
        <>
          {/* tags={post.data.tags} */}
          {/* img={post.data.heroImage} */}
          <CardBlog
            pubDate={post.data.pubDate}
            title={post.data.title}
            badge={post.data.badge}
            heroImage={post.data.heroImage}
            desc={post.data.description}
            url={"/blog/" + createSlug(post.data.title, post.id) + "/"}
            target="_self"
          />
        </>
      ))
    }
    <DividerNav />
    <PreviousPosts lang="es" />
  </section>
</BaseLayout>
