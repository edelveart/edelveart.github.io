---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import createSlug from "@ts-config-path/lib/createSlug";
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import DividerNav from "@components/DividerNav.astro";
import Arrows from "@icons/Arrows.astro";

import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
dayjs.extend(localizedFormat);

import {
  BORDER_OPACITY,
  CARD_OP,
  GET_COLORS_METADATA,
  LINKS_TO,
  NAV_LINKS_PAGES,
} from "@styles/utilsCSS";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection("blog");

  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return paginate(posts, { pageSize: 20 });
};

type Props = {
  page: {
    data: CollectionEntry<"blog">[];
    currentPage: number;
    url: { current: string; prev?: string; next?: string };
  };
};

const { page } = Astro.props as Props;
---

<BaseLayout title="Archive - Edgar Delgado Vega">
  <article class="mt-5 pb-3">
    <div class="mb-10">
      <h1 class="text-3xl font-bold">Archive</h1>
      <p class="mt-3 text-sm text-base-content/70">
        A chronological index of all my blog posts in English and Spanish.
      </p>
      <p class="mt-2 text-xs text-base-content/60">
        {page.data.length} entries on this page.
      </p>
    </div>

    <div class="flex flex-col">
      {
        page.data.map((post) => {
          const isSpanish = post.data.lang === "es";
          const POST_URL_ENG_ESP =
            (isSpanish ? "/es/blog/" : "/blog/") +
            createSlug(post.data.title, post.id) +
            "/";
          return (
            <article class="group my-2">
              <div class="flex flex-wrap items-start gap-x-4 gap-y-2">
                <div class="flex flex-wrap items-center justify-left gap-x-4 gap-y-2 w-full">
                  <a
                    href={POST_URL_ENG_ESP}
                    class="flex flex-1 min-w-0 items-start gap-x-4"
                  >
                    <time class={`${CARD_OP.muteData} w-24 shrink-0 text-left`}>
                      {dayjs(post.data.pubDate).format("ll")}
                    </time>

                    <span class={`min-w-0 ${LINKS_TO}`}>{post.data.title}</span>
                  </a>

                  <span
                    class={`ml-2  ${GET_COLORS_METADATA(post.data.badge)} text-xs`}
                  >
                    {post.data.badge}
                  </span>

                  {/* <div
                    class={`shrink-0 px-2 py-0.5 uppercase tracking-wide ${badge_color}`}
                    lang={isSpanish ? "es" : "en"}
                  >
                    {isSpanish ? "ES" : "EN"}
                  </div> */}

                  {/* <p class={`mt-1 ${CARD_OP.parr} line-clamp-2`}>
                    {post.data.description}
                  </p> */}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
    <DividerNav />

    <nav class="grid grid-cols-2 gap-2" aria-label="Archive pagination">
      {
        page.url.prev ? (
          <a
            class={`${NAV_LINKS_PAGES.aLink} ${NAV_LINKS_PAGES.prevLeft}`}
            href={page.url.prev}
          >
            <span class={NAV_LINKS_PAGES.arrowSpan}>
              <Arrows direction="left" />
            </span>
            <div>
              <div class={NAV_LINKS_PAGES.prevNext}>NEWER</div>
              <div class={NAV_LINKS_PAGES.pageTitle}>Recent entries</div>
            </div>
          </a>
        ) : (
          <a
            class={`${NAV_LINKS_PAGES.aLink} ${NAV_LINKS_PAGES.prevLeft}`}
            href="/"
          >
            <span class={NAV_LINKS_PAGES.arrowSpan}>
              <Arrows direction="left" />
            </span>
            <div>
              <div class={NAV_LINKS_PAGES.prevNext}>HOME</div>
              <div class={NAV_LINKS_PAGES.pageTitle}>Homepage</div>
            </div>
          </a>
        )
      }

      {
        page.url.next ? (
          <a
            class={`${NAV_LINKS_PAGES.aLink} ${NAV_LINKS_PAGES.nextRight}`}
            href={page.url.next}
          >
            <div class="text-right">
              <div class={NAV_LINKS_PAGES.prevNext}>OLDER</div>
              <div class={NAV_LINKS_PAGES.pageTitle}>Earlier entries</div>
            </div>
            <span class={NAV_LINKS_PAGES.arrowSpan}>
              <Arrows direction="right" />
            </span>
          </a>
        ) : (
          <div />
        )
      }
    </nav>
  </article>
</BaseLayout>
