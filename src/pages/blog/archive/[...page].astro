---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import createSlug from "@ts-config-path/lib/createSlug";
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";

import DividerNav from "@components/DividerNav.astro";
import Arrows from "@icons/Arrows.astro";

import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
dayjs.extend(localizedFormat);

import {
  BORDER_INFO,
  CARD_OP,
  GET_COLORS_METADATA,
  NAV_LINKS_PAGES,
} from "@styles/utilsCSS";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection("blog");

  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return paginate(posts, { pageSize: 20 });
};

type Props = {
  page: {
    data: CollectionEntry<"blog">[];
    currentPage: number;
    url: { current: string; prev?: string; next?: string };
  };
};

const { page } = Astro.props as Props;
---

<BaseLayout title="Archive - Edgar Delgado Vega">
  <section>
    <h1 class="text-3xl font-bold tracking-tight">Archive</h1>

    <div class={`${BORDER_INFO} mt-5 mb-6 text-sm text-base-content/75`}>
      <p>A chronological index of all my blog posts in English and Spanish.</p>
      <p class="mt-1 text-xs uppercase tracking-wide">
        {page.data.length} entries on this page
      </p>
    </div>

    <ul class="mt-6">
      {page.data.map((post) => {
        const isSpanish = post.data.lang === "es";

        const postUrl =
          (isSpanish ? "/es/blog/" : "/blog/") +
          createSlug(post.data.title, post.id) +
          "/";

        return (
          <li class="border-b border-base-content/10 last:border-b-0">
            <a
              href={postUrl}
              lang={post.data.lang}
              class="group flex items-center justify-between gap-4 py-1.5 transition-colors duration-200 hover:text-primary"
            >
              <div class="min-w-0 flex-1">
                <span
                  class={`block ${CARD_OP.archiveTitle} transition-colors group-hover:text-primary`}
                >
                  {post.data.title}
                </span>

                <span class={`${CARD_OP.muteData} mt-1 block text-xs`}>
                  {dayjs(post.data.pubDate).format("ll")}
                </span>
              </div>

              <span
                class={`shrink-0 text-xs ${GET_COLORS_METADATA(post.data.badge)}`}
              >
                {post.data.badge}
              </span>
            </a>
          </li>
        );
      })}
    </ul>

    <DividerNav mt="mt-2" />

    <nav class="grid grid-cols-2 gap-2" aria-label="Archive pagination">
      {page.url.prev ? (
        <a
          class={`${NAV_LINKS_PAGES.aLink} ${NAV_LINKS_PAGES.prevLeft}`}
          href={page.url.prev}
        >
          <span class={NAV_LINKS_PAGES.arrowSpan}>
            <Arrows direction="left" />
          </span>

          <div>
            <div class={NAV_LINKS_PAGES.prevNext}>NEWER</div>
            <div class={NAV_LINKS_PAGES.pageTitle}>Recent entries</div>
          </div>
        </a>
      ) : (
        <a class={`${NAV_LINKS_PAGES.aLink} ${NAV_LINKS_PAGES.prevLeft}`} href="/">
          <span class={NAV_LINKS_PAGES.arrowSpan}>
            <Arrows direction="left" />
          </span>

          <div>
            <div class={NAV_LINKS_PAGES.prevNext}>HOME</div>
            <div class={NAV_LINKS_PAGES.pageTitle}>Homepage</div>
          </div>
        </a>
      )}

      {page.url.next ? (
        <a
          class={`${NAV_LINKS_PAGES.aLink} ${NAV_LINKS_PAGES.nextRight}`}
          href={page.url.next}
        >
          <div class="text-right">
            <div class={NAV_LINKS_PAGES.prevNext}>OLDER</div>
            <div class={NAV_LINKS_PAGES.pageTitle}>Earlier entries</div>
          </div>

          <span class={NAV_LINKS_PAGES.arrowSpan}>
            <Arrows direction="right" />
          </span>
        </a>
      ) : (
        <div />
      )}
    </nav>
  </section>
</BaseLayout>
