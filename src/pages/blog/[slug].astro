---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@layouts/PostLayout.astro";
import TableOfContents from "@components/TableOfContents.astro";
import createSlug from "@ts-config-path/lib/createSlug";
import PhotoProfile from "@components/img-components/PhotoProfile.astro";
import DividerNav from "@components/DividerNav.astro";
import Arrows from "@icons/Arrows.astro";
import RSS from "@icons/RSS.astro";
import {
  NAV_LINKS_PAGES,
  MAX_W_CONTENT,
  GET_COLORS_METADATA,
} from "@styles/utilsCSS";

export async function getStaticPaths() {
  const postEntries = await getCollection("blog", ({ data }) => data.lang !== "es");
  const sorted = postEntries.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  return sorted.map((entry, index) => {
    const slug = createSlug(entry.data.title, entry.id);

    const prev = sorted[index - 1] ?? null;
    const next = sorted[index + 1] ?? null;

    return {
      params: { slug },
      props: {
        entry,
        prevPost: prev
          ? {
              title: prev.data.title,
              slug: createSlug(prev.data.title, prev.id),
            }
          : null,
        nextPost: next
          ? {
              title: next.data.title,
              slug: createSlug(next.data.title, next.id),
            }
          : null,
      },
    };
  });
}

type NavBar = {
  title?: string | null;
  slug?: string | null;
};

interface Props {
  entry: CollectionEntry<"blog">;
  prevPost: NavBar;
  nextPost: NavBar;
}

const { entry, prevPost, nextPost } = Astro.props;
const { data: post } = entry;
const { Content, headings } = await render(entry);
---

<PostLayout
  id={entry.id}
  title={post.title}
  description={post.description}
  pubDate={post.pubDate}
  updatedDate={post.updatedDate}
  heroImage={post.heroImage}
  badge={post.badge}
  tags={post.tags}
>
  <div class="flex flex-col gap-5 xl:flex-row xl:items-start xl:gap-12 pr-4">
    <!-- Post content -->
    <div class="order-2 min-w-0 flex-1 xl:order-1">
      <Content />
    </div>

    <!-- Table of Contents -->
    <div class="order-1 xl:order-2 xl:sticky xl:top-24 xl:w-56 xl:shrink-0 xl:self-start xl:mt-5 mt-3">
      <TableOfContents headings={headings} lang={post.lang} />
    </div>
  </div>

  <div class={`w-full ${MAX_W_CONTENT}`}>
    <!-- AUTHOR -->
    <div class="not-prose flex items-center gap-3 mt-5 mb-2">
      <PhotoProfile class="not-prose size-12 shrink-0" />

      <div class="flex-1 min-w-0">
        <div class="text-sm font-semibold">Edgar Delgado Vega</div>
        <div class="text-xs text-base-content/80">
          Mathematical music geek · Open-source tool builder
        </div>
      </div>

      <a
        href="/rss.xml"
        target="_blank"
        rel="noopener noreferrer"
        class="ml-auto shrink-0 text-base-content/80 hover:text-primary transition-colors"
        aria-label="Subscribe to my RSS feed"
      >
        <RSS class="size-4" />
      </a>
    </div>

    <!-- TAGS -->
    <div class={`flex flex-wrap gap-2 mb-6`}>
      {post.tags?.map((tag) => (
        <a
          href={`/blog/tag/${tag}/`}
          class={`${GET_COLORS_METADATA("tags")} text-sm`}
        >
          {tag}
        </a>
      ))}
    </div>
    <DividerNav />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
      {nextPost ? (
        <a
          class={`${NAV_LINKS_PAGES.aLink} ${NAV_LINKS_PAGES.prevLeft}`}
          href={"/blog/" + nextPost.slug + "/"}
        >
          <span class={NAV_LINKS_PAGES.arrowSpan}>
            <Arrows direction="left" />
          </span>
          <div class="text-left">
            <div class={NAV_LINKS_PAGES.prevNext}>OLDER</div>
            <div class={NAV_LINKS_PAGES.pageTitle}>{nextPost.title}</div>
          </div>
        </a>
      ) : (
        <div />
      )}
      {prevPost ? (
        <a
          class={`${NAV_LINKS_PAGES.aLink} ${NAV_LINKS_PAGES.nextRight}`}
          href={"/blog/" + prevPost.slug + "/"}
        >
          <div class="text-right">
            <div class={NAV_LINKS_PAGES.prevNext}>NEWER</div>
            <div class={NAV_LINKS_PAGES.pageTitle}>{prevPost.title}</div>
          </div>
          <span class={NAV_LINKS_PAGES.arrowSpan}>
            <Arrows direction="right" />
          </span>
        </a>
      ) : (
        <a
          class={`${NAV_LINKS_PAGES.aLink} ${NAV_LINKS_PAGES.nextRight}`}
          href="/blog/"
        >
          <div class="text-right">
            <div class={NAV_LINKS_PAGES.prevNext}>NOTES</div>
            <div class={NAV_LINKS_PAGES.pageTitle}>Back to notes</div>
          </div>
          <span class={NAV_LINKS_PAGES.arrowSpan}>
            <Arrows direction="right" />
          </span>
        </a>
      )}
    </div>
  </div>
</PostLayout>
